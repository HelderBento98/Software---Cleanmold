' ---------------------------------------------------------------------------
' Cleanmold 1.0.0 - reconstrucao da peca no SolidWorks
' Peca: Eixo de teste
' Como usar: no SolidWorks, Ferramentas > Macro > Executar... e escolha este arquivo (.swb).
' A macro cria uma peca nova com: Esboco do perfil (retas, arcos, relacoes e cotas) e a Revolucao.
' Para mudar uma medida depois: de dois cliques na revolucao ou no esboco e edite a cota.
' Medidas em mm no SolidWorks; aqui dentro a API trabalha em metros.
' ---------------------------------------------------------------------------
Option Explicit

Dim swApp As Object
Dim Part As Object
Dim skm As Object
Dim seg() As Object
Dim eixo As Object
Dim falhas As String

Sub main()
    Dim modelo As String, pedir As Boolean, k As Long, n As Long
    Dim feat As Object, sd As Object, ok As Boolean, d As Object
    Set swApp = Application.SldWorks
    modelo = swApp.GetUserPreferenceStringValue(8)            ' modelo padrao de peca
    Set Part = swApp.NewDocument(modelo, 0, 0, 0)
    If Part Is Nothing Then
        MsgBox "Nao consegui criar uma peca nova. Confira o modelo padrao de peca em Opcoes > Modelos padrao.", vbExclamation, "Cleanmold"
        Exit Sub
    End If
    Set skm = Part.SketchManager
    pedir = swApp.GetUserPreferenceToggle(10)                 ' pedir o valor da cota ao criar
    swApp.SetUserPreferenceToggle 10, False

    ' ---- 1. esboco do perfil no primeiro plano de referencia (Plano Frontal)
    Set feat = PlanoDeReferencia(1)
    If feat Is Nothing Then
        MsgBox "Nao encontrei o Plano Frontal desta peca.", vbExclamation, "Cleanmold"
        GoTo fim
    End If
    feat.Select2 False, 0
    skm.InsertSketch True
    skm.AddToDB = True                                        ' sem encaixe automatico: as coordenadas entram exatas
    skm.DisplayWhenAdded = False
    Set eixo = skm.CreateCenterLine(-0.005000000, 0, 0, 0.125000000, 0, 0)
    n = 8
    ReDim seg(1 To n)
    Set seg(1) = skm.CreateLine(0.000000000, 0.000000000, 0, 0.000000000, 0.018000000, 0)
    Set seg(2) = skm.CreateLine(0.000000000, 0.018000000, 0, 0.040000000, 0.018000000, 0)
    Set seg(3) = skm.CreateLine(0.040000000, 0.018000000, 0, 0.040000000, 0.025000000, 0)
    Set seg(4) = skm.CreateLine(0.040000000, 0.025000000, 0, 0.094990000, 0.025000000, 0)
    Set seg(5) = skm.CreateLine(0.094990000, 0.025000000, 0, 0.103010000, 0.019990000, 0)
    Set seg(6) = skm.CreateLine(0.103010000, 0.019990000, 0, 0.120000000, 0.019990000, 0)
    Set seg(7) = skm.CreateLine(0.120000000, 0.019990000, 0, 0.120000000, 0.000000000, 0)
    Set seg(8) = skm.CreateLine(0.120000000, 0.000000000, 0, 0.000000000, 0.000000000, 0)
    skm.DisplayWhenAdded = True
    skm.AddToDB = False
    For k = 1 To n
        If seg(k) Is Nothing Then
            MsgBox "O SolidWorks recusou o trecho " & k & " do perfil. A macro parou com o esboco aberto.", vbExclamation, "Cleanmold"
            GoTo fim
        End If
    Next k

    ' ---- 2. relacoes: pontas unidas, eixo fixo, cilindros paralelos ao eixo, faces perpendiculares
    On Error Resume Next
    For k = 1 To n - 1
        Unir seg(k), seg(k + 1)
    Next k
    Unir seg(n), seg(1)
    Part.ClearSelection2 True
    eixo.Select4 False, Nothing: Part.SketchAddConstraints "sgFIXED"
    Part.ClearSelection2 True: seg(1).Select4 False, Nothing: Part.SketchAddConstraints "sgVERTICAL2D"
    Part.ClearSelection2 True: seg(2).Select4 False, Nothing: Part.SketchAddConstraints "sgHORIZONTAL2D"
    Part.ClearSelection2 True: seg(3).Select4 False, Nothing: Part.SketchAddConstraints "sgVERTICAL2D"
    Part.ClearSelection2 True: seg(4).Select4 False, Nothing: Part.SketchAddConstraints "sgHORIZONTAL2D"
    Part.ClearSelection2 True: seg(6).Select4 False, Nothing: Part.SketchAddConstraints "sgHORIZONTAL2D"
    Part.ClearSelection2 True: seg(7).Select4 False, Nothing: Part.SketchAddConstraints "sgVERTICAL2D"
    Part.ClearSelection2 True: seg(8).Select4 False, Nothing: Part.SketchAddConstraints "sgHORIZONTAL2D"

    ' ---- 3. cotas (diametros, posicoes das faces, cones e raios)
    Cotar2 seg(2), eixo, 0.020000000, -0.010250000        ' diametro 36.000 mm
    Cotar2 seg(1), seg(3), 0.020000000, 0.037750000        ' posicao 40.000 mm
    Cotar2 seg(4), eixo, 0.067495000, -0.014250000        ' diametro 50.000 mm
    CotarH seg(5), 0.099000000, 0.027495000        ' comprimento do cone 8.020 mm
    CotarV seg(5), 0.106010000, 0.022495000        ' altura do cone 5.010 mm
    Cotar2 seg(6), eixo, 0.111505000, -0.018250000        ' diametro 39.980 mm
    Cotar2 seg(1), seg(7), 0.060000000, 0.049750000        ' posicao 120.000 mm
    Part.ClearSelection2 True: seg(1).Select4 False, Nothing: Part.SketchAddConstraints "sgFIXED"
    On Error GoTo 0
    Part.ClearSelection2 True
    skm.InsertSketch True                                     ' fecha o esboco
    Set feat = Part.FeatureByPositionReverse(0)
    If Not feat Is Nothing Then feat.Name = "Perfil (Cleanmold)"

    ' ---- 4. revolucao
    Part.ClearSelection2 True
    If Not feat Is Nothing Then feat.Select2 False, 0
    Set sd = Part.SelectionManager.CreateSelectData
    sd.Mark = 16                                              ' 16 = eixo da revolucao
    eixo.Select4 True, sd
    Set d = Nothing
    On Error Resume Next
    Set d = Part.FeatureManager.FeatureRevolve2(True, True, False, False, False, False, 0, 0, 6.283185307, 0, False, False, 0.01, 0.01, 0, 0, 0, True, True, True)
    On Error GoTo 0
    Set feat = Part.FeatureByPositionReverse(0)
    If d Is Nothing And InStr(1, feat.GetTypeName2, "Rev", vbTextCompare) = 0 Then
        MsgBox "O esboco do perfil foi criado, mas a revolucao nao saiu sozinha." & vbCrLf & _
               "Selecione o esboco Perfil (Cleanmold) e use Inserir > Ressalto/Base > Revolucao.", vbExclamation, "Cleanmold"
    Else
        feat.Name = "Revolucao (Cleanmold)"
    End If
    Part.ClearSelection2 True
    Part.ViewZoomtofit2
    If Len(falhas) > 0 Then MsgBox "Peca criada. Algumas cotas ou relacoes nao entraram:" & vbCrLf & falhas & vbCrLf & _
        "A geometria esta certa; complete as cotas pelo comando Totalmente definir esboco.", vbInformation, "Cleanmold"
fim:
    swApp.SetUserPreferenceToggle 10, pedir
End Sub

' n-esimo plano de referencia da peca (1 = Frontal, 2 = Superior, 3 = Direito), sem depender do idioma
Function PlanoDeReferencia(n As Long) As Object
    Dim f As Object, k As Long
    Set f = Part.FirstFeature
    Do While Not f Is Nothing
        If f.GetTypeName2 = "RefPlane" Then
            k = k + 1
            If k = n Then
                Set PlanoDeReferencia = f
                Exit Function
            End If
        End If
        Set f = f.GetNextFeature
    Loop
End Function

' une a ponta final de um trecho ao comeco do seguinte (se o SolidWorks ja uniu, nao faz nada)
Sub Unir(a As Object, b As Object)
    Dim p As Object, q As Object
    On Error Resume Next
    Set p = a.GetEndPoint2
    Set q = b.GetStartPoint2
    If p Is Nothing Or q Is Nothing Then Exit Sub
    If p Is q Then Exit Sub
    Part.ClearSelection2 True
    p.Select4 False, Nothing
    q.Select4 True, Nothing
    Part.SketchAddConstraints "sgMERGEPOINTS"
    Part.ClearSelection2 True
End Sub

Sub Anotar(o As Object, oque As String)
    If o Is Nothing Then falhas = falhas & "  - " & oque & vbCrLf
End Sub

' cota de um trecho sozinho (raio de arco)
Sub Cotar1(a As Object, x As Double, y As Double)
    Dim d As Object
    On Error Resume Next
    Part.ClearSelection2 True
    a.Select4 False, Nothing
    Set d = Part.AddDimension2(x, y, 0)
    Anotar d, "raio"
End Sub

' cota entre dois trechos (cilindro e eixo = diametro; face e face = distancia)
Sub Cotar2(a As Object, b As Object, x As Double, y As Double)
    Dim d As Object
    On Error Resume Next
    Part.ClearSelection2 True
    a.Select4 False, Nothing
    b.Select4 True, Nothing
    Set d = Part.AddDimension2(x, y, 0)
    Anotar d, "diametro ou posicao"
End Sub

Sub CotarH(a As Object, x As Double, y As Double)
    Dim d As Object
    On Error Resume Next
    Part.ClearSelection2 True
    a.Select4 False, Nothing
    Set d = Part.AddHorizontalDimension2(x, y, 0)
    Anotar d, "comprimento de cone"
End Sub

Sub CotarV(a As Object, x As Double, y As Double)
    Dim d As Object
    On Error Resume Next
    Part.ClearSelection2 True
    a.Select4 False, Nothing
    Set d = Part.AddVerticalDimension2(x, y, 0)
    Anotar d, "altura de cone"
End Sub
